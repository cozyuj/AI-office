{
  "name": "claude-ai-office",
  "version": "0.25.1",
  "description": "Claude Code 세션 활동을 아이소메트릭 사무실로 실시간 시각화",
  "keywords": [
    "claude",
    "claude-code",
    "hooks",
    "visualization",
    "isometric",
    "office",
    "dashboard",
    "developer-tools"
  ],
  "homepage": "https://github.com/cozyuj/AI-office#readme",
  "bugs": {
    "url": "https://github.com/cozyuj/AI-office/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cozyuj/AI-office.git"
  },
  "license": "MIT",
  "author": "cozyuj",
  "bin": {
    "ai-office": "bin/ai-office.js"
  },
  "files": [
    "bin",
    "server.js",
    "lib",
    "hooks",
    "public",
    "scripts",
    "README.md",
    "docs/ARCHITECTURE.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "demo": "node scripts/demo.js",
    "install-hooks": "node scripts/install-hooks.js",
    "uninstall-hooks": "node scripts/install-hooks.js --remove",
    "test": "node --test test/*.test.js",
    "cli": "node bin/ai-office.js",
    "app:dev": "node scripts/fetch-node.js && npm --prefix app run dev",
    "app:build": "node scripts/fetch-node.js && npm --prefix app run build",
    "app:icon": "npm --prefix app run icon",
    "bump:patch": "node scripts/bump-version.js patch",
    "bump:minor": "node scripts/bump-version.js minor",
    "bump:major": "node scripts/bump-version.js major",
    "prepublishOnly": "npm test"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "commonjs"
}
