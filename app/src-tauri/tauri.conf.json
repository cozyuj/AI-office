{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Office",
  "version": "0.34.0",
  "identifier": "io.bigxdata.aioffice",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AI Office",
        "width": 1360,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "url": "index.html",
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "externalBin": [
      "binaries/node"
    ],
    "resources": {
      "../../server.js": "server/server.js",
      "../../package.json": "server/package.json",
      "../../lib": "server/lib",
      "../../public": "server/public",
      "../../scripts": "server/scripts",
      "../../hooks": "server/hooks"
    },
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Korean",
          "English"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY4QjQ0NENDQjYxRjk3MUMKUldRY2x4KzJ6RVMwK042RlZmbTM1TmdBaWFieUFmSEdka1d2anhFQWRUcERMdDMvTVBUd2hoam0K",
      "endpoints": [
        "https://github.com/cozyuj/AI-office/releases/latest/download/latest.json"
      ]
    }
  }
}
